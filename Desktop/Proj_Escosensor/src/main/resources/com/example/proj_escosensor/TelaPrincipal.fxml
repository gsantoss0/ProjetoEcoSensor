                <Button alignment="CENTER" mnemonicParsing="false" onAction="#btnLigarVent" prefHeight="25.0" prefWidth="80.0" text="Ligar" />
                <Button mnemonicParsing="false" onAction="#btnDesligarVent" prefHeight="25.0" prefWidth="80.0" text="Desligar" />
            </children>
        </HBox>
    </children>
</AnchorPane>
